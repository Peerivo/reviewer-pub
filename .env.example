# GitHub App identity. Keep the private key only in the deployment secret store.
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-me

# GitLab self-service OAuth installation (recommended).
# GITLAB_BASE_URL may point to GitLab.com or one HTTPS GitLab Self-Managed instance.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PUBLIC_URL=https://reviewer.example.com
GITLAB_OAUTH_CLIENT_ID=replace-me
GITLAB_OAUTH_CLIENT_SECRET=replace-me
GITLAB_INSTALLATIONS_DB=/data/gitlab-installations.sqlite
GITLAB_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
GITLAB_OAUTH_STATE_TTL_MS=600000
GITLAB_INSTALL_SESSION_TTL_MS=3600000
GITLAB_MAX_DISCOVER_PROJECTS=1000
GITLAB_MAX_INSTALL_PROJECTS=100

# Legacy GitLab fallback. Set all three together only for already-provisioned pilots.
# GITLAB_TOKEN=replace-me
# GITLAB_WEBHOOK_SECRET=replace-me
# GITLAB_PROJECTS=group/project,group/other-project

# Private Peerivo Reviewer service. Never expose this token to customer repositories.
REVIEWER_API_URL=https://reviewer-api.example.com
REVIEWER_API_TOKEN=replace-me

PORT=8080
HOST=0.0.0.0
MAX_FILES=1000
MAX_WORKFLOWS=200
MAX_WORKFLOW_BYTES=1048576
MAX_SECURITY_FILES=200
MAX_SECURITY_FILE_BYTES=524288
MAX_SECURITY_BYTES=4194304
REVIEW_TIMEOUT_MS=30000
