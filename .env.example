# GitHub App identity. Keep the private key only in the deployment secret store.
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-me


# GitLab.com / GitLab Self-Managed integration.
# Use an API-capable server-side token; never expose it to customer repositories.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=replace-me
GITLAB_WEBHOOK_SECRET=replace-me
GITLAB_PROJECTS=group/project

# Private Peerivo Reviewer service. Never expose this token to customer repositories.
REVIEWER_API_URL=https://reviewer-api.example.com
REVIEWER_API_TOKEN=replace-me

PORT=8080
HOST=0.0.0.0
MAX_FILES=1000
MAX_WORKFLOWS=200
MAX_WORKFLOW_BYTES=1048576
MAX_SECURITY_FILES=200
MAX_SECURITY_FILE_BYTES=524288
MAX_SECURITY_BYTES=4194304
REVIEW_TIMEOUT_MS=30000
